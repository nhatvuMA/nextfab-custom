# Copy to .env.local. Everything is optional — without these the app runs on a
# local JSON store (.data/) with a demo checkout so you can click through it.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API). Service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test keys first). Webhook: /api/stripe/webhook, event checkout.session.completed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Staff CRM login (prototype). Replace with Supabase Auth for production.
ADMIN_PASSWORD=nextfab
ADMIN_SECRET=change-me
